# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/tws_workspace
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
HOLD_MINUTES=10
TAX_RATE=0.18
BOOKING_PREFIX=TWS
BUSINESS_EMAIL=
BUSINESS_PHONE=

# Email (SMTP) for transactional booking notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=The Workspace <bookings@example.com>
DEV_EMAIL_CAPTURE=true

# Payments: mock is development-only; switch to cashfree after adding credentials below.
PAYMENT_PROVIDER=mock

# Seeded administrator (always use a strong unique production password)
SEED_ADMIN_EMAIL=admin@tws.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Dynamic booking assistant (server-only; never prefix this with VITE_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cashfree Payment Gateway
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01
# Configure this endpoint in Cashfree: https://your-api.example.com/api/payments/cashfree/webhook
